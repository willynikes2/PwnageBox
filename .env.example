# ============================================================================
# PwnageBox Environment Configuration
# Copy this to .env and customize values
# ============================================================================

# Splunk Configuration
SPLUNK_PASSWORD=CHANGE_ME
SPLUNK_TOKEN=CHANGE_ME

# Web UI Authentication
# start.sh refuses to run while any value above or below is still CHANGE_ME.
RECRUITER_PASSWORD=CHANGE_ME

# Rate Limiting (seconds between attacks)
RATE_LIMIT_SECONDS=45
